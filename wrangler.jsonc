{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "next-gen-engagement",
  "main": "server/index.ts",
  "compatibility_date": "2026-11-05",
  "assets": { "directory": "./dist/client", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "observability": { "enabled": false },
  "ratelimits": [
    { "name": "ADMISSIONS_LIMITER", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } },
    { "name": "ATTENDANCE_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ]
}
