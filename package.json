{
  "name": "next-gen-engagement",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "npm run test:domain && vitest run",
    "test:domain": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "hono": "4.13.16",
    "lucide-react": "1.61.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "vitest": "^4.0.0",
    "wrangler": "^4.0.0"
  }
}
